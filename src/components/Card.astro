---
interface Props {
  class?: string;
  padded?: boolean;
  as?: string;
}
const { class: className = "", padded = true, as = "div" } = Astro.props;
const Tag = as;
---

<Tag class:list={["card", { "card--padded": padded }, className]}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    background: linear-gradient(180deg, var(--bg-surface-raised) 0%, var(--bg-surface) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: linear-gradient(90deg, transparent, var(--border-strong) 40%, transparent 90%);
  }
  .card--padded {
    padding: var(--space-6);
  }
</style>
