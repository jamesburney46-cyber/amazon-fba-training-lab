---
interface Props {
  class?: string;
  padded?: boolean;
  as?: string;
}
const { class: className = "", padded = true, as = "div" } = Astro.props;
const Tag = as;
---

<Tag class:list={["card", { "card--padded": padded }, className]}>
  <slot />
</Tag>

<style>
  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .card--padded {
    padding: var(--space-6);
  }
</style>
