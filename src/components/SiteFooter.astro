---
import { url } from "@/lib/paths";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">FBA Operator Lab</p>
      <p class="site-footer__tagline">
        Evidence-led Amazon FBA training and product-research practice.
        Training only — no live Amazon account actions.
      </p>
    </div>
    <nav class="site-footer__links" aria-label="Footer">
      <a href={url("/curriculum/")}>Curriculum</a>
      <a href={url("/research-machine/")}>Research Machine</a>
      <a href={url("/scorecard/")}>Scorecard</a>
      <a href={url("/resources/")}>Resources</a>
      <a href={url("/glossary/")}>Glossary</a>
    </nav>
  </div>
  <div class="container">
    <p class="site-footer__legal">
      © {year} FBA Operator Lab. Educational content only. Not affiliated
      with Amazon. Sponsored Products / Amazon Ads references link to
      Amazon's own official resources.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-12) 0 var(--space-8);
    margin-top: var(--space-24);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    justify-content: space-between;
    padding-bottom: var(--space-8);
  }
  .site-footer__brand {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
  }
  .site-footer__tagline {
    max-width: 32ch;
    font-size: var(--text-sm);
    margin-bottom: 0;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .site-footer__links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .site-footer__links a:hover {
    color: var(--text-primary);
  }
  .site-footer__legal {
    font-size: var(--text-xs);
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
    margin-bottom: 0;
  }
</style>
