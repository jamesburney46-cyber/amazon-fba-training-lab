---
import { url } from "@/lib/paths";

interface Props {
  variant?: "public" | "app";
}
const { variant = "public" } = Astro.props;

const publicLinks = [
  { href: url("/curriculum/"), label: "Curriculum" },
  { href: url("/research-machine/"), label: "Product Research Machine" },
  { href: url("/scorecard/"), label: "Scorecard" },
  { href: url("/resources/"), label: "Resources" },
];

const appLinks = [
  { href: url("/dashboard/"), label: "Dashboard" },
  { href: url("/curriculum/"), label: "Curriculum" },
  { href: url("/research-machine/"), label: "Research Machine" },
  { href: url("/scorecard/"), label: "Scorecard" },
  { href: url("/resources/"), label: "Resources" },
  { href: url("/glossary/"), label: "Glossary" },
];

const links = variant === "app" ? appLinks : publicLinks;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href={url("/")}>
      <span class="brand__mark" aria-hidden="true">FL</span>
      <span class="brand__name">FBA Operator Lab</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {links.map((link) => (
          <li><a class="nav__link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      {variant === "public" ? (
        <>
          <a class="header-actions__link" href={url("/auth/sign-in/")}>Sign in</a>
          <a class="header-actions__cta" href={url("/auth/sign-up/")}>Start training</a>
        </>
      ) : (
        <a class="header-actions__link" href={url("/account/")}>Account</a>
      )}
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <span class="visually-hidden">Toggle menu</span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" data-mobile-nav hidden>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      {variant === "public" ? (
        <>
          <li><a href={url("/auth/sign-in/")}>Sign in</a></li>
          <li><a href={url("/auth/sign-up/")}>Start training</a></li>
        </>
      ) : (
        <li><a href={url("/account/")}>Account</a></li>
      )}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg-canvas) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--gold-500) 12%, transparent);
  }
  .site-header__inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
    margin-right: auto;
  }
  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: linear-gradient(155deg, var(--accent-500) 0%, var(--accent-600) 100%);
    border: 1px solid color-mix(in srgb, var(--gold-500) 45%, transparent);
    color: var(--accent-contrast);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
  }
  .nav__list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .nav__link:hover {
    color: var(--text-primary);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .header-actions__link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .header-actions__link:hover {
    color: var(--text-primary);
  }
  .header-actions__cta {
    text-decoration: none;
    background: var(--accent-500);
    color: var(--accent-contrast);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-md);
  }
  .header-actions__cta:hover {
    background: var(--accent-400);
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-toggle__bar,
  .menu-toggle__bar::before,
  .menu-toggle__bar::after {
    content: "";
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-primary);
    position: relative;
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .menu-toggle__bar::before {
    position: absolute;
    top: -6px;
  }
  .menu-toggle__bar::after {
    position: absolute;
    top: 6px;
  }

  .mobile-nav {
    display: none;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .mobile-nav a {
    display: block;
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-medium);
  }
  .mobile-nav a:hover {
    background: var(--bg-surface-hover);
  }
  .mobile-nav.is-open {
    display: block;
  }

  @media (max-width: 860px) {
    .nav,
    .header-actions {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  toggle?.addEventListener("click", () => {
    const isOpen = mobileNav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    if (mobileNav) mobileNav.hidden = !isOpen;
  });
</script>
