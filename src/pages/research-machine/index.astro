---
import AppLayout from "@/layouts/AppLayout.astro";
import Callout from "@/components/Callout.astro";
import ecoFlexPreview from "@/assets/research-machine/ecoflex-preview.png";
import { funnelStages, researchDiscipline } from "@/data/researchMachine";
import { url } from "@/lib/paths";

const stageLabels: Record<string, string> = {
  raw: "A · Raw ideas",
  "fast-rejection": "B · Fast rejection",
  evidence: "C · Evidence screen",
  "commercial-model": "D · Commercial model",
  "investment-case": "E · Investment case",
};
---

<AppLayout
  title="Product Research Machine"
  description="Practise the 30 → 10 → 5 → 3 → owner-decision product research funnel."
>
  <header class="page-head">
    <p class="eyebrow">Practice tool</p>
    <h1>Product Research Machine <span class="beta-pill">Beta</span></h1>
    <p class="page-head__lede">
      The Product Research Machine is being built to turn raw Amazon product
      ideas into evidence-led investment decisions. Below is an illustrative
      example of the type of result the finished machine will produce.
    </p>
  </header>

  <Callout tone="warning" title="Beta preview">
    The full research workflow is still under development. This preview shows
    the kind of completed product opportunity report the finished Research
    Machine is intended to produce.
  </Callout>

  <div id="demo-banner" hidden>
    <Callout tone="warning" title="Demo mode — no Supabase project connected">
      Your board is saved only in this browser (local storage), not to an
      account. Connect Supabase — see <code>SETUP.md</code> — to persist
      candidates across devices.
    </Callout>
  </div>
  <div id="signed-out-banner" hidden>
    <Callout tone="warning" title="Not signed in">
      Your board is saved only in this browser (local storage), not to an
      account. <a href={url("/auth/sign-in/")}>Sign in</a> or
      <a href={url("/auth/sign-up/")}>create an account</a> to persist
      candidates across devices.
    </Callout>
  </div>
  <div id="signed-in-banner" hidden>
    <Callout tone="success" title="Saved to your account">
      This board reads and writes your candidates to your Supabase account —
      it persists across devices and sessions.
    </Callout>
  </div>

  <section class="funnel-guide" hidden>
    {funnelStages.map((stage) => (
      <details class="funnel-guide__item">
        <summary>{stage.title}</summary>
        <p>{stage.description}</p>
        <ul>
          {stage.criteria.map((c) => <li>{c}</li>)}
        </ul>
      </details>
    ))}
  </section>

  <section class="discipline" hidden>
    <div>
      <h2>Say this</h2>
      <ul>
        {researchDiscipline.preferred.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div>
      <h2>Not this</h2>
      <ul>
        {researchDiscipline.avoid.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="result-preview" aria-labelledby="result-preview-heading">
    <div class="result-preview__top">
      <div>
        <span class="sample-badge">Illustrative completed result</span>
        <p class="result-preview__kicker">Product opportunity report</p>
        <h2 id="result-preview-heading">EcoFlex Bamboo Travel Cutlery Set</h2>
        <p class="result-preview__summary">
          A portable bamboo cutlery kit aimed at eco-conscious commuters,
          travellers and lunchbox users. The opportunity shows credible demand
          and a clear customer complaint to solve, but margin and differentiation
          still need verification before committing cash.
        </p>
      </div>
      <div class="result-preview__score">
        <span>Opportunity score</span>
        <strong>74</strong>
        <small>/ 100</small>
      </div>
    </div>

    <div class="result-preview__visual">
      <img
        class="result-preview__hero-image"
        src={ecoFlexPreview.src}
        alt="Illustrative EcoFlex Bamboo Travel Cutlery Set product research result"
        loading="lazy"
      />

      <div class="result-preview__metrics">
        <div>
          <span>Target selling price</span>
          <strong>£19.99</strong>
        </div>
        <div>
          <span>Estimated landed cost</span>
          <strong>£4.10</strong>
        </div>
        <div>
          <span>Estimated Amazon fees</span>
          <strong>£6.40</strong>
        </div>
        <div>
          <span>Target advertising CPA</span>
          <strong>£3.50</strong>
        </div>
        <div class="result-preview__metric--primary">
          <span>Indicative contribution</span>
          <strong>£5.99/unit</strong>
        </div>
        <div>
          <span>Primary demand signal</span>
          <strong>~9,000 searches/mo</strong>
        </div>
      </div>
    </div>

    <div class="result-preview__analysis">
      <article>
        <span class="result-preview__label">Demand</span>
        <h3>Evidence of an active market</h3>
        <p>
          Primary keyword demand is estimated at roughly 9,000 monthly searches,
          with established competitors selling between approximately £14 and £24.
        </p>
      </article>

      <article>
        <span class="result-preview__label">Differentiation</span>
        <h3>A customer problem worth investigating</h3>
        <p>
          Competitor reviews repeatedly mention pieces failing to clip together,
          creating a plausible product-improvement angle if it can be engineered
          and protected from easy copying.
        </p>
      </article>

      <article>
        <span class="result-preview__label">Risk</span>
        <h3>Crowded category and thin economics</h3>
        <p>
          Many competing sets look almost identical. The economics are acceptable
          on paper but leave limited room for price pressure, higher advertising
          costs or unexpected freight and duty.
        </p>
      </article>
    </div>

    <div class="result-preview__decision">
      <div>
        <span>Machine recommendation</span>
        <strong>INVESTIGATE</strong>
      </div>
      <p>
        Promising enough to continue researching, but not yet strong enough to
        place an order. Verify demand, supplier economics and a defensible
        differentiation angle before capital is committed.
      </p>
    </div>

    <p class="result-preview__footer">
      The finished Research Machine will guide a product through rejection,
      evidence, economics and risk analysis before producing a decision like this.
    </p>
  </section>

  <section class="board" id="research-board" data-research-board hidden>
    <div class="board__toolbar">
      <form data-add-form class="board__add">
        <label for="add-input" class="visually-hidden">New candidate idea</label>
        <input
          id="add-input"
          data-add-input
          type="text"
          placeholder="Add a raw product idea…"
          maxlength="120"
        />
        <button type="submit">Add to Stage A</button>
      </form>
      <button type="button" class="board__reset" data-reset-board>
        Clear board
      </button>
    </div>
    <p class="board__error" data-add-error role="alert"></p>
    <p class="board__status" data-board-status role="status" aria-live="polite"></p>

    <div class="board__columns">
      {["raw", "fast-rejection", "evidence", "commercial-model", "investment-case"].map((stage) => (
        <div class="board-column">
          <div class="board-column__head">
            <h3>{stageLabels[stage]}</h3>
            <span data-stage-count={stage}>0 / 0</span>
          </div>
          <ul class="board-column__list" data-stage-list={stage}></ul>
        </div>
      ))}
    </div>

    <p class="board__rejected">
      Rejected this session: <strong data-rejected-count>0</strong> — a high
      rejection count is a valid, healthy outcome.
    </p>
  </section>
</AppLayout>

<script>
  import { initResearchMachine } from "@/scripts/researchMachine";
  const board = document.querySelector<HTMLElement>("[data-research-board]");
  if (board) initResearchMachine(board);
</script>

<style>
  .eyebrow {
    color: var(--accent-400);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .page-head {
    margin-bottom: var(--space-6);
  }
  .page-head__lede {
    max-width: 68ch;
  }
  .beta-pill {
    display: inline-flex;
    align-items: center;
    margin-left: var(--space-3);
    padding: 0.15rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--status-investigate);
    background: var(--status-investigate-tint);
    border: 1px solid color-mix(in srgb, var(--status-investigate) 35%, transparent);
    border-radius: var(--radius-full);
    vertical-align: middle;
  }
  .funnel-guide {
    margin: var(--space-8) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .funnel-guide__item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    padding: var(--space-4) var(--space-5);
  }
  .funnel-guide__item summary {
    cursor: pointer;
    font-weight: var(--weight-medium);
    color: var(--text-primary);
  }
  .funnel-guide__item p {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .funnel-guide__item ul {
    font-size: var(--text-sm);
  }

  .discipline {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }
  .discipline h2 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }
  .discipline ul {
    font-size: var(--text-sm);
  }

  .sample-candidate {
    border: 1px dashed color-mix(in srgb, var(--status-investigate) 45%, var(--border-default));
    border-radius: var(--radius-lg);
    background: var(--status-investigate-tint);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .sample-candidate__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .sample-candidate__head h2 {
    font-size: var(--text-lg);
    margin: 0;
  }
  .sample-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--status-investigate);
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--status-investigate) 45%, transparent);
    border-radius: var(--radius-full);
  }
  .sample-candidate__blurb {
    max-width: 72ch;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .sample-candidate__facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .sample-candidate__facts div {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .sample-candidate__facts dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .sample-candidate__facts dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .sample-candidate__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .sample-candidate__actions button {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: var(--accent-500);
    color: var(--accent-contrast);
    cursor: pointer;
  }
  .sample-candidate__actions button:hover {
    background: var(--accent-400);
  }
  .sample-candidate__actions a {
    font-size: var(--text-sm);
    color: var(--accent-400);
  }
  .sample-candidate__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--status-go);
    min-height: 1.2em;
  }

  .board {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-inset);
    padding: var(--space-6);
  }
  .board__toolbar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  .board__add {
    display: flex;
    gap: var(--space-3);
    flex: 1;
    min-width: 260px;
  }
  .board__add input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
  }
  .board__add button {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: var(--accent-500);
    color: var(--accent-contrast);
    cursor: pointer;
  }
  .board__reset {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }
  .board__reset:hover {
    color: var(--text-primary);
  }
  .board__error {
    color: var(--status-reject);
    font-size: var(--text-sm);
    min-height: 1.2em;
    margin: var(--space-2) 0 var(--space-4);
  }
  .board__status {
    color: var(--status-go);
    font-size: var(--text-xs);
    min-height: 1.2em;
    margin: 0 0 var(--space-4);
  }

  .board__columns {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }
  .board-column {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    min-height: 180px;
  }
  .board-column__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }
  .board-column__head h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-secondary);
    margin: 0;
  }
  .board-column__head span {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .board-column__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  :global(.board-empty) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: var(--space-3);
    text-align: center;
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-sm);
  }
  :global(.board-card) {
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }
  :global(.board-card__name) {
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
    word-break: break-word;
  }
  :global(.board-card__actions) {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  :global(.board-card__btn) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
  }
  :global(.board-card__btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.board-card__btn--advance:hover:not(:disabled)) {
    border-color: var(--status-go);
    color: var(--status-go);
  }
  :global(.board-card__btn--reject:hover) {
    border-color: var(--status-reject);
    color: var(--status-reject);
  }
  :global(.board-card__rec) {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  :global(.board-card__rec label) {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  :global(.board-card__rec select) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
  }
  :global(.board-card__score-link) {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--accent-400);
    text-decoration: none;
  }
  .board__rejected {
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .board__columns {
      grid-template-columns: repeat(2, 1fr);
    }
    .discipline {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .board__columns {
      grid-template-columns: 1fr;
    }
  }

  .result-preview {
    margin: var(--space-8) 0;
    padding: var(--space-7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .result-preview__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }

  .result-preview__kicker {
    margin: var(--space-3) 0 var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: .05em;
  }

  .result-preview__top h2 {
    margin: 0 0 var(--space-3);
  }

  .result-preview__summary {
    max-width: 68ch;
  }

  .result-preview__score {
    min-width: 140px;
    text-align: center;
    padding: var(--space-4);
    background: var(--bg-inset);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .result-preview__score span,
  .result-preview__score small {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .result-preview__score strong {
    display: block;
    font-size: 2.6rem;
    line-height: 1;
    margin: var(--space-2) 0;
    color: var(--status-investigate);
  }

  .result-preview__visual {
    display: grid;
    grid-template-columns: minmax(240px, .8fr) 1.4fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .product-mock {
    min-height: 310px;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 30% 20%, rgba(255,255,255,.16), transparent 34%),
      linear-gradient(145deg, #b89668, #73573b);
    border: 1px solid rgba(255,255,255,.08);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-5);
    color: white;
  }

  .product-mock__case {
    position: absolute;
    width: 70%;
    height: 42%;
    left: 15%;
    top: 20%;
    border-radius: 999px;
    background: #d9c29f;
    box-shadow: 0 18px 45px rgba(0,0,0,.25);
  }

  .product-mock__utensil {
    position: absolute;
    top: 27%;
    font-size: 2rem;
    color: #694d32;
    z-index: 2;
  }

  .product-mock__utensil--fork { left: 30%; }
  .product-mock__utensil--spoon { left: 48%; }
  .product-mock__utensil--knife {
    left: 66%;
    width: 8px;
    height: 90px;
    background: #694d32;
    border-radius: 999px;
  }

  .product-mock p {
    margin: 0;
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
    position: relative;
  }

  .product-mock span {
    font-size: var(--text-sm);
    opacity: .8;
    position: relative;
  }

  .result-preview__metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .result-preview__metrics > div {
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-inset);
  }

  .result-preview__metrics span {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
  }

  .result-preview__metrics strong {
    font-size: var(--text-lg);
  }

  .result-preview__metric--primary {
    border-color: color-mix(in srgb, var(--status-go) 40%, var(--border-subtle)) !important;
  }

  .result-preview__analysis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .result-preview__analysis article {
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .result-preview__analysis h3 {
    font-size: var(--text-base);
    margin: var(--space-2) 0;
  }

  .result-preview__analysis p {
    font-size: var(--text-sm);
    margin: 0;
  }

  .result-preview__label {
    color: var(--accent-400);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .result-preview__decision {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--status-investigate-tint);
    border: 1px solid color-mix(in srgb, var(--status-investigate) 35%, transparent);
  }

  .result-preview__decision span {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-bottom: var(--space-1);
  }

  .result-preview__decision strong {
    color: var(--status-investigate);
  }

  .result-preview__decision p {
    margin: 0;
