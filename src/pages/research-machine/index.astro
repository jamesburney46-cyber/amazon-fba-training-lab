---
import AppLayout from "@/layouts/AppLayout.astro";
import Callout from "@/components/Callout.astro";
import { funnelStages, researchDiscipline } from "@/data/researchMachine";
import { url } from "@/lib/paths";

const stageLabels: Record<string, string> = {
  raw: "A · Raw ideas",
  "fast-rejection": "B · Fast rejection",
  evidence: "C · Evidence screen",
  "commercial-model": "D · Commercial model",
  "investment-case": "E · Investment case",
};
---

<AppLayout
  title="Product Research Machine"
  description="Practise the 30 → 10 → 5 → 3 → owner-decision product research funnel."
>
  <header class="page-head">
    <p class="eyebrow">Practice tool</p>
    <h1>Product Research Machine <span class="beta-pill">Beta</span></h1>
    <p class="page-head__lede">
      Add candidate product ideas and move them through the same funnel used
      to turn 30 raw ideas into a maximum of three defensible candidates.
      This is a practice board — no research tooling or live Amazon data is
      connected; you are practising the discipline of rejection.
    </p>
  </header>

  <Callout tone="warning" title="Beta — this workflow is still being refined">
    The Product Research Machine is under active development. Stages, fields
    and scoring may change as the tool is refined, and it is not yet a
    finished production feature. Any real candidates you add and save here
    stay private to you — either to your signed-in account, or to this
    browser if you are not signed in — nobody else can see them.
  </Callout>

  <div id="demo-banner" hidden>
    <Callout tone="warning" title="Demo mode — no Supabase project connected">
      Your board is saved only in this browser (local storage), not to an
      account. Connect Supabase — see <code>SETUP.md</code> — to persist
      candidates across devices.
    </Callout>
  </div>
  <div id="signed-out-banner" hidden>
    <Callout tone="warning" title="Not signed in">
      Your board is saved only in this browser (local storage), not to an
      account. <a href={url("/auth/sign-in/")}>Sign in</a> or
      <a href={url("/auth/sign-up/")}>create an account</a> to persist
      candidates across devices.
    </Callout>
  </div>
  <div id="signed-in-banner" hidden>
    <Callout tone="success" title="Saved to your account">
      This board reads and writes your candidates to your Supabase account —
      it persists across devices and sessions.
    </Callout>
  </div>

  <section class="funnel-guide">
    {funnelStages.map((stage) => (
      <details class="funnel-guide__item">
        <summary>{stage.title}</summary>
        <p>{stage.description}</p>
        <ul>
          {stage.criteria.map((c) => <li>{c}</li>)}
        </ul>
      </details>
    ))}
  </section>

  <section class="discipline">
    <div>
      <h2>Say this</h2>
      <ul>
        {researchDiscipline.preferred.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div>
      <h2>Not this</h2>
      <ul>
        {researchDiscipline.avoid.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="sample-candidate" data-sample-candidate aria-labelledby="sample-candidate-heading">
    <div class="sample-candidate__head">
      <span class="sample-badge">Sample · not your data</span>
      <h2 id="sample-candidate-heading">EcoFlex Bamboo Travel Cutlery Set</h2>
    </div>
    <p class="sample-candidate__blurb">
      An illustrative, fictional example showing what a candidate looks like
      once it has been worked through the whole funnel to Stage E. The
      product, numbers and notes below are realistic placeholders for
      teaching the flow — they are not real research and are not saved
      anywhere until you choose to copy the idea onto your own board.
    </p>
    <dl class="sample-candidate__facts">
      <div>
        <dt>Stage reached</dt>
        <dd>E · Investment case (illustrative)</dd>
      </div>
      <div>
        <dt>Evidence (Stage C)</dt>
        <dd>
          Primary keyword "bamboo travel cutlery set", ~9,000 est. monthly
          searches; top 10 competitors £14–£24; mixed 3.9★ average with
          recurring "pieces don't clip together" complaints — a plausible
          differentiation angle.
        </dd>
      </div>
      <div>
        <dt>Indicative economics (Stage D)</dt>
        <dd>
          Sell price £19.99 · landed unit cost £4.10 · Amazon fees £6.40 ·
          target CPA £3.50 → contribution ≈ £5.99/unit before overheads.
        </dd>
      </div>
      <div>
        <dt>Key risk</dt>
        <dd>
          Category is crowded with near-identical bamboo sets — needs a
          verified, defensible differentiation angle before committing cash.
        </dd>
      </div>
      <div>
        <dt>Recommendation</dt>
        <dd>INVESTIGATE — evidence is promising but contribution is thin and unverified.</dd>
      </div>
    </dl>
    <div class="sample-candidate__actions">
      <button type="button" data-copy-sample>Copy idea to Stage A</button>
      <a href={url("/scorecard/")}>See how this would score →</a>
    </div>
    <p class="sample-candidate__note" data-copy-sample-status role="status" aria-live="polite"></p>
  </section>

  <section class="board" id="research-board" data-research-board>
    <div class="board__toolbar">
      <form data-add-form class="board__add">
        <label for="add-input" class="visually-hidden">New candidate idea</label>
        <input
          id="add-input"
          data-add-input
          type="text"
          placeholder="Add a raw product idea…"
          maxlength="120"
        />
        <button type="submit">Add to Stage A</button>
      </form>
      <button type="button" class="board__reset" data-reset-board>
        Clear board
      </button>
    </div>
    <p class="board__error" data-add-error role="alert"></p>
    <p class="board__status" data-board-status role="status" aria-live="polite"></p>

    <div class="board__columns">
      {["raw", "fast-rejection", "evidence", "commercial-model", "investment-case"].map((stage) => (
        <div class="board-column">
          <div class="board-column__head">
            <h3>{stageLabels[stage]}</h3>
            <span data-stage-count={stage}>0 / 0</span>
          </div>
          <ul class="board-column__list" data-stage-list={stage}></ul>
        </div>
      ))}
    </div>

    <p class="board__rejected">
      Rejected this session: <strong data-rejected-count>0</strong> — a high
      rejection count is a valid, healthy outcome.
    </p>
  </section>
</AppLayout>

<script>
  import { initResearchMachine } from "@/scripts/researchMachine";
  const board = document.querySelector<HTMLElement>("[data-research-board]");
  if (board) initResearchMachine(board);
</script>

<style>
  .eyebrow {
    color: var(--accent-400);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-2);
  }
  .page-head {
    margin-bottom: var(--space-6);
  }
  .page-head__lede {
    max-width: 68ch;
  }
  .beta-pill {
    display: inline-flex;
    align-items: center;
    margin-left: var(--space-3);
    padding: 0.15rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--status-investigate);
    background: var(--status-investigate-tint);
    border: 1px solid color-mix(in srgb, var(--status-investigate) 35%, transparent);
    border-radius: var(--radius-full);
    vertical-align: middle;
  }
  .funnel-guide {
    margin: var(--space-8) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .funnel-guide__item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    padding: var(--space-4) var(--space-5);
  }
  .funnel-guide__item summary {
    cursor: pointer;
    font-weight: var(--weight-medium);
    color: var(--text-primary);
  }
  .funnel-guide__item p {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .funnel-guide__item ul {
    font-size: var(--text-sm);
  }

  .discipline {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }
  .discipline h2 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }
  .discipline ul {
    font-size: var(--text-sm);
  }

  .sample-candidate {
    border: 1px dashed color-mix(in srgb, var(--status-investigate) 45%, var(--border-default));
    border-radius: var(--radius-lg);
    background: var(--status-investigate-tint);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .sample-candidate__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .sample-candidate__head h2 {
    font-size: var(--text-lg);
    margin: 0;
  }
  .sample-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--status-investigate);
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--status-investigate) 45%, transparent);
    border-radius: var(--radius-full);
  }
  .sample-candidate__blurb {
    max-width: 72ch;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .sample-candidate__facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .sample-candidate__facts div {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .sample-candidate__facts dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .sample-candidate__facts dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
  .sample-candidate__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .sample-candidate__actions button {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: var(--accent-500);
    color: var(--accent-contrast);
    cursor: pointer;
  }
  .sample-candidate__actions button:hover {
    background: var(--accent-400);
  }
  .sample-candidate__actions a {
    font-size: var(--text-sm);
    color: var(--accent-400);
  }
  .sample-candidate__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--status-go);
    min-height: 1.2em;
  }

  .board {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-inset);
    padding: var(--space-6);
  }
  .board__toolbar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  .board__add {
    display: flex;
    gap: var(--space-3);
    flex: 1;
    min-width: 260px;
  }
  .board__add input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
  }
  .board__add button {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: var(--accent-500);
    color: var(--accent-contrast);
    cursor: pointer;
  }
  .board__reset {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }
  .board__reset:hover {
    color: var(--text-primary);
  }
  .board__error {
    color: var(--status-reject);
    font-size: var(--text-sm);
    min-height: 1.2em;
    margin: var(--space-2) 0 var(--space-4);
  }
  .board__status {
    color: var(--status-go);
    font-size: var(--text-xs);
    min-height: 1.2em;
    margin: 0 0 var(--space-4);
  }

  .board__columns {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }
  .board-column {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    min-height: 180px;
  }
  .board-column__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }
  .board-column__head h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-secondary);
    margin: 0;
  }
  .board-column__head span {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .board-column__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  :global(.board-empty) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: var(--space-3);
    text-align: center;
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-sm);
  }
  :global(.board-card) {
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }
  :global(.board-card__name) {
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
    word-break: break-word;
  }
  :global(.board-card__actions) {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  :global(.board-card__btn) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
  }
  :global(.board-card__btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.board-card__btn--advance:hover:not(:disabled)) {
    border-color: var(--status-go);
    color: var(--status-go);
  }
  :global(.board-card__btn--reject:hover) {
    border-color: var(--status-reject);
    color: var(--status-reject);
  }
  :global(.board-card__rec) {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  :global(.board-card__rec label) {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  :global(.board-card__rec select) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
  }
  :global(.board-card__score-link) {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--accent-400);
    text-decoration: none;
  }
  .board__rejected {
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .board__columns {
      grid-template-columns: repeat(2, 1fr);
    }
    .discipline {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .board__columns {
      grid-template-columns: 1fr;
    }
  }
</style>
