---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/Card.astro";
import Button from "@/components/Button.astro";
import Badge from "@/components/Badge.astro";
import Callout from "@/components/Callout.astro";
import VideoThumb from "@/components/VideoThumb.astro";
import ProgressBar from "@/components/ProgressBar.astro";
import { getWeekPreviewVideo } from "@/data/videos";
import { url } from "@/lib/paths";

const pillars = [
  {
    title: "Watch",
    body: "Short, curated official and third-party video/reading — never the whole internet, just the parts that matter.",
  },
  {
    title: "Do",
    body: "A concrete practical exercise every night. Passive watching alone never counts as training completed.",
  },
  {
    title: "Explain back",
    body: "The learner writes the lesson in their own words, as if teaching someone else. This is where understanding gets tested.",
  },
  {
    title: "Checkpoint",
    body: "One number, decision, or short answer that proves the lesson landed — not a multiple-choice quiz.",
  },
];

const weeks = [
  { n: 1, title: "How Amazon FBA actually works", status: "live" },
  { n: 2, title: "Product research: demand before enthusiasm", status: "live" },
  { n: 3, title: "Competition, reviews and differentiation", status: "planned" },
  { n: 4, title: "Unit economics and cash", status: "planned" },
  { n: 5, title: "Suppliers, sourcing, samples and negotiation", status: "planned" },
  { n: 6, title: "Freight, import VAT, duty and landed cost", status: "planned" },
  { n: 7, title: "Listing and conversion", status: "planned" },
  { n: 8, title: "PPC without wasting money", status: "planned" },
  { n: 9, title: "Inventory and stock planning", status: "planned" },
  { n: 10, title: "Compliance, IP and business discipline", status: "planned" },
  { n: 11, title: "Supervised product-research apprenticeship", status: "planned" },
  { n: 12, title: "Investment-committee simulation", status: "planned" },
];

const funnel = [
  { stage: "A", count: "30 raw ideas", detail: "Broad discovery across marketplace browsing, research tools, review mining and demand signals." },
  { stage: "B", count: "10 survive fast rejection", detail: "Hard-stop screen removes brand moats, fragile/oversized items, thin margin and weak demand before any real time is spent." },
  { stage: "C", count: "5 survive the evidence screen", detail: "Keyword demand, competitor pricing, review themes, differentiation and compliance risk captured for each survivor." },
  { stage: "D", count: "3 reach a full commercial model", detail: "Complete unit economics: contribution after PPC, break-even ACoS, MOQ cash exposure and cash-conversion cycle." },
  { stage: "E", count: "Owner decision", detail: "A maximum of three candidates ever reach a GO / INVESTIGATE / REJECT owner decision — most ideas are rejected before anyone's time is spent on them." },
];
---

<BaseLayout
  title="Home"
  description="A premium, evidence-led Amazon FBA training and product-research platform. Learn the full operating model, then practise the research machine that separates real opportunities from noise."
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Training + product research, not a business dashboard</p>
        <h1>Learn Amazon FBA the way a disciplined operator actually runs it.</h1>
        <p class="hero__lede">
          A 12-week guided programme and a repeatable product-research machine —
          built to teach demand-before-enthusiasm thinking, real unit economics,
          and the discipline to reject far more ideas than you accept, before
          any capital is ever committed.
        </p>
        <div class="hero__actions">
          <Button href={url("/auth/sign-up/")} size="md" data-auth-signed-out>Start training</Button>
          <Button href={url("/dashboard/")} size="md" data-auth-signed-in hidden>Continue training</Button>
          <Button href={url("/curriculum/")} variant="secondary" size="md">
            Preview the curriculum
          </Button>
        </div>
        <p class="hero__note">
          Training and research only. No live Amazon account changes, no
          supplier orders, no PPC deployment happen inside this product.
        </p>
      </div>

      <aside class="hero__panel" aria-label="How the research machine narrows ideas" data-auth-signed-out>
        <p class="hero__panel-kicker">The research machine, at a glance</p>
        <ol class="hero__funnel">
          <li><span class="hero__funnel-badge">A</span><span>30 raw ideas</span></li>
          <li><span class="hero__funnel-badge">B</span><span>10 survive fast rejection</span></li>
          <li><span class="hero__funnel-badge">C</span><span>5 survive the evidence screen</span></li>
          <li><span class="hero__funnel-badge">D</span><span>3 reach a full commercial model</span></li>
          <li class="hero__funnel-decision">
            <span class="hero__funnel-badge hero__funnel-badge--decision">E</span>
            <span>Owner decision: GO / INVESTIGATE / REJECT</span>
          </li>
        </ol>
        <p class="hero__panel-note">
          Most ideas are rejected before anyone's time is spent on them —
          that discipline is the product.
        </p>
      </aside>

      <aside class="hero__panel hero__progress" data-home-progress data-auth-signed-in hidden aria-label="Your training progress">
        <p class="hero__panel-kicker">Your training progress</p>

        <div class="hero__progress-position">
          <span>Where you are</span>
          <strong data-home-position>Loading your progress…</strong>
        </div>

        <div data-home-progressbar>
          <ProgressBar value={0} label="Programme complete" />
        </div>

        <p class="hero__progress-count" data-home-progress-count>
          Loading lesson progress…
        </p>

        <div class="hero__next">
          <span class="hero__next-label">Next lesson</span>
          <strong data-home-next-title>Loading…</strong>
          <span data-home-next-meta></span>
        </div>

        <a class="hero__progress-cta" data-home-next-link href={url("/dashboard/")}>
          Continue training
        </a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Every lesson follows the same disciplined loop</h2>
      <p class="section__lede">
        No passive video marathons. Each night is short, deliberate, and ends
        with proof of understanding.
      </p>
      <div class="grid grid--4">
        {pillars.map((p, i) => (
          <Card class={`pillar-card pillar-card--${i + 1}`}>
            <p class="pillar__index">{String(i + 1).padStart(2, "0")}</p>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section__head">
        <div>
          <h2>The 12-week journey</h2>
          <p class="section__lede">
            Weeks 1–2 are fully built and ready to use. Weeks 3–12 are
            planned and will open on the same Watch → Do → Explain Back →
            Checkpoint structure — they are intentionally not populated yet
            in this release.
          </p>
        </div>
        <Button href={url("/curriculum/")} variant="secondary" size="sm">
          View full curriculum
        </Button>
      </div>
      <ol class="week-grid">
        {weeks.map((w) => {
          const previewVideo = getWeekPreviewVideo(w.n);
          return (
            <li
              class:list={[
                "week-tile",
                `week-tile--${((w.n - 1) % 4) + 1}`,
                { "week-tile--planned": w.status === "planned" },
              ]}
            >
              {previewVideo && (
                <VideoThumb
                  youtubeId={previewVideo.youtubeId}
                  title={previewVideo.title}
                  class="week-tile__thumb"
                />
              )}
              <span class="week-tile__number">Week {w.n}</span>
              <span class="week-tile__title">{w.title}</span>
              <span class="week-tile__status">
                {w.status === "live" ? "Available now" : "Planned"}
              </span>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <div>
          <h2>The Product Research Machine</h2>
          <p class="section__lede">
            The same funnel used to turn scattered product ideas into a
            defensible shortlist — practise it directly, candidate by
            candidate, before it ever touches real money.
          </p>
        </div>
        <Button href={url("/research-machine/")} variant="secondary" size="sm">
          Open the research machine
        </Button>
      </div>
      <div class="funnel">
        {funnel.map((f) => (
          <div class="funnel__stage">
            <span class:list={["funnel__badge", { "funnel__badge--decision": f.stage === "E" }]}>
              {f.stage}
            </span>
            <div>
              <p class="funnel__count">{f.count}</p>
              <p class="funnel__detail">{f.detail}</p>
            </div>
          </div>
        ))}
      </div>
      <Callout tone="info" title="The machine's job is to reject, not to sell you on ideas">
        <p>
          A month with no acceptable product is a valid outcome if every
          candidate that month was genuinely weak. The scorecard and hard-stop
          gates exist to make rejection defensible, not to justify enthusiasm.
        </p>
      </Callout>
    </div>
  </section>

  <section class="section section--muted evidence-section">
    <div class="container">
      <div class="section__head">
        <div>
          <h2>Evidence you can trust, clearly labelled</h2>
          <p class="section__lede">
            Every resource in the library is tagged by source so you always
            know whether you're reading Amazon's own rules, UK government
            guidance, or a third-party walkthrough.
          </p>
        </div>
        <Button href={url("/resources/")} variant="secondary" size="sm">
          Browse resource library
        </Button>
      </div>
      <div class="badge-row">
        <Badge kind="official" /> Amazon Seller University, Amazon Ads —
        the factual backbone.
      </div>
      <div class="badge-row">
        <Badge kind="govuk" /> Import, VAT, duty, EORI and IP guidance —
        used as-is, never reinterpreted as legal advice.
      </div>
      <div class="badge-row">
        <Badge kind="third-party" /> Structured walkthroughs for context —
        never the sole source for a compliance or financial claim.
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="container cta__inner">
      <span class="cta__eyebrow">Put the discipline into practice</span>
      <h2>Ready to see whether an idea survives the evidence?</h2>
      <p class="section__lede">
        Create a free account to track your progress through the programme,
        or preview everything first — the curriculum, resources and tools
        are visible before you sign in.
      </p>
      <div class="hero__actions">
        <Button href={url("/auth/sign-up/")} data-auth-signed-out>Create free account</Button>
        <Button href={url("/dashboard/")} data-auth-signed-in hidden>Continue training</Button>
        <Button href={url("/scorecard/")} variant="secondary">
          Try the 100-point scorecard
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCurrentSession, getSupabaseClient, isSupabaseConfigured } from "@/lib/supabase";
  import { getAllLessons, weeks } from "@/data/curriculum";
  import { url } from "@/lib/paths";

  async function loadHomeProgress() {
    if (!isSupabaseConfigured) return;

    const supabase = getSupabaseClient();
    const session = await getCurrentSession();

    if (!supabase || !session?.user) return;

    const userId = session.user.id;

    const { data: rows } = await supabase
      .from("lesson_progress")
      .select("week_slug, lesson_slug, status, checkpoint_answer")
      .eq("user_id", userId);

    const progressRows = rows ?? [];
    const allLessons = getAllLessons();

    const completedKeys = new Set(
      progressRows
        .filter((r) => r.status === "complete")
        .map((r) => `${r.week_slug}:${r.lesson_slug}`)
    );

    const completeCount = allLessons.filter((lesson) =>
      completedKeys.has(`${lesson.weekSlug}:night-${lesson.night}`)
    ).length;

    const totalCount = allLessons.length;
    const pct = totalCount > 0
      ? Math.round((completeCount / totalCount) * 100)
      : 0;

    const nextLesson = allLessons.find(
      (lesson) => !completedKeys.has(`${lesson.weekSlug}:night-${lesson.night}`)
    );

    const position = document.querySelector("[data-home-position]");
    const count = document.querySelector("[data-home-progress-count]");
    const nextTitle = document.querySelector("[data-home-next-title]");
    const nextMeta = document.querySelector("[data-home-next-meta]");
    const nextLink = document.querySelector("[data-home-next-link]");
    const progressWrap = document.querySelector("[data-home-progressbar]");

    const fill = progressWrap?.querySelector(".progress__fill");
    const track = progressWrap?.querySelector(".progress__track");
    const pctLabel = progressWrap?.querySelectorAll(".progress__label span")[1];

    if (fill instanceof HTMLElement) fill.style.width = `${pct}%`;
    if (pctLabel) pctLabel.textContent = `${pct}%`;
    track?.setAttribute("aria-valuenow", String(pct));

    if (count) {
      count.textContent = `${completeCount} of ${totalCount} lessons complete`;
    }

    if (nextLesson) {
      const activeWeek = weeks.find((w) => w.slug === nextLesson.weekSlug);

      if (position) {
        position.textContent = `Week ${nextLesson.weekN} · Night ${nextLesson.night}`;
      }

      if (nextTitle) {
        nextTitle.textContent = nextLesson.lessonTitle;
      }

      if (nextMeta) {
        nextMeta.textContent = activeWeek?.title ?? "";
      }

      if (nextLink instanceof HTMLAnchorElement) {
        nextLink.href = `${url(`/curriculum/${nextLesson.weekSlug}/`)}#night-${nextLesson.night}`;
        nextLink.textContent = completeCount > 0 ? "Continue training" : "Start training";
      }
    } else {
      if (position) position.textContent = "All available lessons complete";
      if (nextTitle) nextTitle.textContent = "You're fully caught up";
      if (nextMeta) nextMeta.textContent = "Review the curriculum or practise product research.";

      if (nextLink instanceof HTMLAnchorElement) {
        nextLink.href = url("/curriculum/");
        nextLink.textContent = "Review curriculum";
      }
    }
  }

  void loadHomeProgress();
</script>


<style>
  .eyebrow {
    color: var(--accent-400);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .hero {
    padding-block: var(--space-20) var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(55% 65% at 15% 0%, var(--accent-tint), transparent 60%),
      radial-gradient(40% 50% at 100% 10%, var(--gold-tint), transparent 65%),
      var(--bg-canvas);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: var(--space-12);
    align-items: center;
  }
  .hero__lede {
    font-size: var(--text-md);
    max-width: 60ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }
  .hero__note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .hero__panel {
    background: linear-gradient(180deg, var(--bg-surface-raised) 0%, var(--bg-surface) 100%);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
  }
  .hero__panel-kicker {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .hero__funnel {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hero__funnel li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .hero__funnel-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    background: var(--accent-tint);
    color: var(--accent-400);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }
  .hero__funnel-decision {
    color: var(--text-primary);
    font-weight: var(--weight-medium);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }
  .hero__funnel-badge--decision {
    background: var(--gold-tint);
    color: var(--gold-400);
  }
  .hero__panel-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .section {
    padding-block: var(--space-16);
  }
  .section--muted {
    background: var(--bg-inset);
    border-block: 1px solid var(--border-subtle);
  }
  .section__lede {
    max-width: 62ch;
    font-size: var(--text-base);
  }
  .section__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
  }
  .grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .pillar__index {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
  }

  .week-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .week-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
  }
  .week-tile__thumb {
    width: 104px;
    margin-bottom: var(--space-3);
  }

  .week-tile__number {
    font-size: var(--text-xs);
    color: var(--accent-400);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .week-tile__title {
    color: var(--text-primary);
    font-weight: var(--weight-medium);
  }
  .week-tile__status {
    font-size: var(--text-xs);
    color: var(--status-go);
  }
  .week-tile--planned {
    opacity: 0.6;
  }
  .week-tile--planned .week-tile__status {
    color: var(--text-muted);
  }

  .funnel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .funnel__stage {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }
  .funnel__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--accent-tint);
    color: var(--accent-400);
    font-weight: var(--weight-semibold);
  }
  .funnel__badge--decision {
    background: var(--gold-tint);
    color: var(--gold-400);
  }
  .funnel__count {
    margin: 0 0 var(--space-1);
    color: var(--text-primary);
    font-weight: var(--weight-medium);
  }
  .funnel__detail {
    margin: 0;
    font-size: var(--text-sm);
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .cta {
    text-align: center;
  }
  .cta__inner {
    max-width: 640px;
    margin-inline: auto;
  }
  .cta .hero__actions {
    justify-content: center;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__panel {
      max-width: 460px;
    }
    .grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .week-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid--4,
    .week-grid {
      grid-template-columns: 1fr;
    }
    .section__head {
      flex-direction: column;
    }
  }

  .hero__progress-position {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .hero__progress-position span,
  .hero__next-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero__progress-position strong {
    color: var(--text-primary);
    font-size: var(--text-md);
  }

  .hero__progress-count {
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin: var(--space-3) 0 var(--space-5);
  }

  .hero__next {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    margin-bottom: var(--space-5);
  }

  .hero__next strong {
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .hero__next > span:last-child {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .hero__progress-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--accent-500);
    color: var(--accent-contrast);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .hero__progress-cta:hover {
    background: var(--accent-400);
  }


  /* ------------------------------------------------------------------
     Controlled colour hierarchy
     Dark premium base stays intact; colour is reserved for navigation,
     learning states and decision points.
     ------------------------------------------------------------------ */

  .pillar-card {
    position: relative;
    overflow: hidden;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .pillar-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--pillar-accent);
  }

  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(
      in srgb,
      var(--pillar-accent) 48%,
      var(--border-default)
    );
    box-shadow:
      0 16px 36px rgba(0, 0, 0, 0.24),
      0 0 28px color-mix(in srgb, var(--pillar-accent) 10%, transparent);
  }

  .pillar-card .pillar__index {
    color: var(--pillar-accent);
  }

  .pillar-card h3 {
    color: color-mix(in srgb, var(--pillar-accent) 25%, var(--text-primary));
  }

  /* Watch — blue */
  .pillar-card--1 {
    --pillar-accent: #60a5fa;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, #60a5fa 7%, transparent),
        transparent 48%
