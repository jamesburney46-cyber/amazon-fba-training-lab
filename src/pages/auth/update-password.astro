---
// Destination page for the password-reset email
// (`sendPasswordReset` → `resetPasswordForEmail(email, { redirectTo })` in
// `src/lib/supabase.ts`). Supabase's client auto-detects the recovery token
// in the URL and establishes a short-lived recovery session; this page just
// waits for that, then submits `updateUser({ password })`.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Callout from "@/components/Callout.astro";
import { url } from "@/lib/paths";
---

<BaseLayout title="Set a new password" description="Set a new FBA Operator Lab password.">
  <div class="container">
    <div class="auth-shell">
      <div class="auth-card animate-in">
        <h1>Set a new password</h1>
        <p class="auth-card__lede">
          Choose a new password for your account.
        </p>

        <div id="demo-notice" hidden>
          <Callout tone="warning" title="Preview / demo mode">
            No Supabase project is connected in this deployment, so there is
            no password to update. Connect Supabase (see <code>SETUP.md</code>)
            to enable this.
          </Callout>
        </div>

        <div id="invalid-link" hidden>
          <Callout tone="danger" title="Link invalid or expired">
            This password reset link is no longer valid. Request a new one
            from the <a href={url("/auth/reset-password/")}>reset password</a> page.
          </Callout>
        </div>

        <form id="update-password-form" novalidate>
          <div class="form-field">
            <label for="password">New password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
            <p class="form-field__hint">At least 8 characters.</p>
          </div>
          <div class="form-field">
            <label for="confirm">Confirm new password</label>
            <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="8" />
          </div>
          <div class="form-actions">
            <Button type="submit" id="update-password-submit">Update password</Button>
          </div>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>

        <p class="auth-switch">
          <a href={url("/auth/sign-in/")}>Back to sign in</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getSupabaseClient, updatePassword, isSupabaseConfigured } from "@/lib/supabase";
  import { url } from "@/lib/paths";

  const demoNotice = document.getElementById("demo-notice");
  const invalidLink = document.getElementById("invalid-link");
  const form = document.getElementById("update-password-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submitBtn = document.getElementById("update-password-submit") as HTMLButtonElement | null;

  if (!isSupabaseConfigured) {
    if (demoNotice) demoNotice.hidden = false;
    if (form) form.hidden = true;
  } else {
    const supabase = getSupabaseClient();
    let hasRecoverySession = false;

    const showForm = () => {
      hasRecoverySession = true;
      if (invalidLink) invalidLink.hidden = true;
    };

    supabase?.auth.onAuthStateChange((event) => {
      if (event === "PASSWORD_RECOVERY" || event === "SIGNED_IN") showForm();
    });

    supabase?.auth.getSession().then(({ data }) => {
      if (data.session) showForm();
    });

    // Give the client a moment to parse the recovery token from the URL
    // before deciding the link is invalid.
    window.setTimeout(() => {
      if (!hasRecoverySession && form && invalidLink) {
        form.hidden = true;
        invalidLink.hidden = false;
      }
    }, 3000);

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status) return;

      const password = (form.elements.namedItem("password") as HTMLInputElement)?.value ?? "";
      const confirm = (form.elements.namedItem("confirm") as HTMLInputElement)?.value ?? "";

      if (password !== confirm) {
        status.className = "form-status is-visible is-error";
        status.textContent = "Passwords do not match.";
        return;
      }

      status.className = "form-status is-visible";
      status.textContent = "Updating…";
      if (submitBtn) submitBtn.setAttribute("aria-disabled", "true");

      const result = await updatePassword(password);

      status.textContent = result.message;
      status.className = `form-status is-visible ${result.ok ? "is-success" : "is-error"}`;
      if (submitBtn) submitBtn.removeAttribute("aria-disabled");

      if (result.ok) {
        window.setTimeout(() => {
          window.location.href = url("/dashboard/");
        }, 1500);
      }
    });
  }
</script>
