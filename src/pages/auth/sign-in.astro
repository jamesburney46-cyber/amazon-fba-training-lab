---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Callout from "@/components/Callout.astro";
import { url } from "@/lib/paths";
---

<BaseLayout title="Sign in" description="Sign in to FBA Operator Lab.">
  <div class="container">
    <div class="auth-shell">
      <div class="auth-card animate-in">
        <h1>Welcome back</h1>
        <p class="auth-card__lede">
          Sign in to pick up your curriculum progress and saved research
          candidates.
        </p>

        <div id="demo-notice" hidden>
          <Callout tone="warning" title="Preview / demo mode">
            No Supabase project is connected in this deployment, so sign-in
            is illustrative only — no real account is created or verified.
            Connect Supabase (see <code>SETUP.md</code>) to enable live
            accounts.
          </Callout>
        </div>

        <form id="sign-in-form" novalidate>
          <div class="form-field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required minlength="8" />
          </div>
          <div class="form-actions">
            <Button type="submit">Sign in</Button>
            <a class="auth-switch" href={url("/auth/reset-password/")}>Forgot your password?</a>
          </div>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>

        <p class="auth-switch">
          New here? <a href={url("/auth/sign-up/")}>Create a free account</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { demoAwareSignIn, isSupabaseConfigured } from "@/lib/supabase";

  const demoNotice = document.getElementById("demo-notice");
  if (!isSupabaseConfigured && demoNotice) demoNotice.hidden = false;

  const form = document.getElementById("sign-in-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    const email = (form.elements.namedItem("email") as HTMLInputElement)?.value ?? "";
    const password = (form.elements.namedItem("password") as HTMLInputElement)?.value ?? "";

    status.className = "form-status is-visible";
    status.textContent = "Checking…";

    const result = await demoAwareSignIn(email, password);

    status.textContent = result.message;
    status.className = `form-status is-visible ${
      result.mode === "demo" ? "is-demo" : result.ok ? "is-success" : "is-error"
    }`;
  });
</script>
