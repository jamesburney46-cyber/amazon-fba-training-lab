---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Callout from "@/components/Callout.astro";
import { url } from "@/lib/paths";
---

<BaseLayout title="Reset password" description="Reset your FBA Operator Lab password.">
  <div class="container">
    <div class="auth-shell">
      <div class="auth-card animate-in">
        <h1>Reset your password</h1>
        <p class="auth-card__lede">
          Enter the email on your account and, once Supabase is connected,
          we'll send a reset link.
        </p>

        <div id="demo-notice" hidden>
          <Callout tone="warning" title="Preview / demo mode">
            No Supabase project is connected in this deployment, so no email
            is actually sent. Connect Supabase (see <code>SETUP.md</code>)
            to enable live password resets.
          </Callout>
        </div>

        <form id="reset-form" novalidate>
          <div class="form-field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="form-actions">
            <Button type="submit" id="reset-submit">Send reset link</Button>
          </div>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>

        <p class="auth-switch">
          Remembered it? <a href={url("/auth/sign-in/")}>Back to sign in</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { sendPasswordReset, isSupabaseConfigured } from "@/lib/supabase";

  const demoNotice = document.getElementById("demo-notice");
  if (!isSupabaseConfigured && demoNotice) demoNotice.hidden = false;

  const form = document.getElementById("reset-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submitBtn = document.getElementById("reset-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    const email = (form.elements.namedItem("email") as HTMLInputElement)?.value ?? "";

    status.className = "form-status is-visible";
    status.textContent = "Sending…";
    if (submitBtn) submitBtn.setAttribute("aria-disabled", "true");

    const result = await sendPasswordReset(email);

    status.textContent = result.message;
    status.className = `form-status is-visible ${
      result.mode === "demo" ? "is-demo" : result.ok ? "is-success" : "is-error"
    }`;
    if (submitBtn) submitBtn.removeAttribute("aria-disabled");
  });
</script>
